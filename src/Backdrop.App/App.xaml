<Application
    x:Class="Backdrop.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Chip-style filter radios (Library page). Implicit: applies to RadioButtons only;
           the app uses no other RadioButtons, so scope is safe. -->
      <Style x:Key="ChipRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
