<Page
    x:Class="Backdrop.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="24" RowSpacing="12" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <AutoSuggestBox x:Name="Search" PlaceholderText="Search wallpapers" Width="280"
                      TextChanged="Search_TextChanged" />
      <Button Content="Import" Style="{StaticResource AccentButtonStyle}" Click="Import_Click" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <RadioButtons x:Name="FilterChips" SelectedIndex="0" SelectionChanged="Filter_Changed" MaxColumns="4">
        <RadioButton Content="All" Style="{StaticResource ChipRadioButtonStyle}" />
        <RadioButton Content="Video" Style="{StaticResource ChipRadioButtonStyle}" />
        <RadioButton Content="GIF" Style="{StaticResource ChipRadioButtonStyle}" />
        <RadioButton Content="HTML" Style="{StaticResource ChipRadioButtonStyle}" />
      </RadioButtons>
      <ComboBox x:Name="SortBox" SelectedIndex="0" SelectionChanged="Sort_Changed">
        <ComboBoxItem Content="Last Used" />
        <ComboBoxItem Content="Date Added" />
        <ComboBoxItem Content="Name" />
      </ComboBox>
    </StackPanel>
    <GridView Grid.Row="2" x:Name="Grid" SelectionMode="Single"
              AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
      <GridView.ItemTemplate>
        <DataTemplate>
          <StackPanel Width="320" Spacing="4" Padding="8">
            <Border CornerRadius="8" Height="180" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <Grid>
                <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
              </Grid>
            </Border>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Type}" Opacity="0.7" FontSize="12" />
          </StackPanel>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
    <StackPanel Grid.Row="2" x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="12" Visibility="Visible">
      <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" FontSize="64" Opacity="0.4"
                 HorizontalAlignment="Center" />
      <TextBlock Text="No wallpapers yet" Style="{StaticResource SubtitleTextBlockStyle}"
                 HorizontalAlignment="Center" />
      <TextBlock Text="Drag &amp; drop videos, GIFs or HTML files here" Opacity="0.6"
                 HorizontalAlignment="Center" />
    </StackPanel>
    <Border Grid.Row="0" Grid.RowSpan="3" x:Name="DragOverlay" Background="#AA202020" CornerRadius="16"
            Margin="24" Visibility="Collapsed" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2" IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="48"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="Drop to import" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
    <InfoBar Grid.Row="3" x:Name="InfoBar" IsOpen="False" Severity="Error" Message="" />
  </Grid>
</Page>
