<Page
    x:Class="Backdrop.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
  <ScrollViewer Padding="24">
    <StackPanel Spacing="12" MaxWidth="680" HorizontalAlignment="Left">
      <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
      <controls:SettingsExpander Header="General" Description="Startup and behavior">
        <ToggleSwitch x:Name="TStartup" Header="Run at startup" Toggled="Startup_Toggled" />
      </controls:SettingsExpander>
      <controls:SettingsExpander Header="Wallpaper" Description="Audio, loop, scaling">
        <StackPanel Spacing="8">
          <ToggleSwitch x:Name="TMute" Header="Mute wallpapers" />
          <Slider x:Name="Volume" Header="Volume" Minimum="0" Maximum="1" StepFrequency="0.05" Width="240" />
          <ToggleSwitch x:Name="TLoop" Header="Loop" />
          <ComboBox x:Name="FillBox" Header="Scaling">
            <ComboBoxItem Content="Fill" />
            <ComboBoxItem Content="Fit" />
            <ComboBoxItem Content="Stretch" />
          </ComboBox>
        </StackPanel>
      </controls:SettingsExpander>
      <controls:SettingsExpander Header="Advanced" Description="Cache and logs">
        <StackPanel Spacing="8">
          <Button Content="Open logs folder" Click="Logs_Click" />
          <Button Content="Clear thumbnail cache" Click="Cache_Click" />
        </StackPanel>
      </controls:SettingsExpander>
      <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
      <InfoBar x:Name="Info" IsOpen="False" Severity="Success" Message="Saved." />
    </StackPanel>
  </ScrollViewer>
</Page>
